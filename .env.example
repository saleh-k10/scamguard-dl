# ScamGuard environment variables — names only, no real values.
# Copy to .env and fill in values from your own Lovable Cloud backend.
# Never commit a real .env file.

# Browser (public/anon values only)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Server
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=

# Server-side AI gateway key (managed by Lovable; never expose to the browser)
LOVABLE_API_KEY=
